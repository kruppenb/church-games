# Random token for teacher mode access (MUST be changed before deploying)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VITE_TEACHER_TOKEN=

# Base URL of the shared leaderboard API, including the /api path.
# Leave unset (or empty) for device-local leaderboards — no network calls at all.
# Production: https://church-games-api.azurewebsites.net/api
# VITE_LEADERBOARD_API=
